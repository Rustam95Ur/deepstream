# Node
NEXUS_DS_HOST=0.0.0.0
# Public port (nginx in docker compose)
NEXUS_DS_PORT=8080
NEXUS_DS_DATA_DIR=./data

# DeepStream (GPU container)
DEEPSTREAM_YOLO_DIR=./models/yolo11n
DEEPSTREAM_WORK_DIR=/tmp/nexus_deepstream
DEEPSTREAM_DEBUG_DIR=./data/debug

# Postgres
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus_deepstream

# App traffic goes through PgBouncer (transaction pool). Migrations hit Postgres directly.
# In Docker Compose these are set automatically.
# NEXUS_DS_DATABASE_URL=postgresql+psycopg://nexus:nexus@127.0.0.1:5432/nexus_deepstream
# NEXUS_DS_DATABASE_MIGRATE_URL=postgresql+psycopg://nexus:nexus@127.0.0.1:5432/nexus_deepstream

# SQLAlchemy pool (one uvicorn worker; keep modest vs PgBouncer DEFAULT_POOL_SIZE)
# NEXUS_DS_DB_POOL_SIZE=20
# NEXUS_DS_DB_MAX_OVERFLOW=20
# NEXUS_DS_DB_POOL_RECYCLE=180
# NEXUS_DS_DB_STATEMENT_TIMEOUT_MS=5000

# History writer (does not block the GPU pipeline)
# NEXUS_DS_HISTORY_QUEUE=20000
# NEXUS_DS_HISTORY_BATCH=200
# NEXUS_DS_HISTORY_FLUSH_MS=200

# Outbound trigger workers (HTTP off the GPU thread)
# NEXUS_DS_SINK_WORKERS=4
# NEXUS_DS_SINK_QUEUE=10000

# Camera list cache for pipeline/API
# NEXUS_DS_CAMERA_CACHE_MS=2000
