# Optional. Without this file, compose defaults are enough on one Ubuntu host:
# Campus gets http://172.17.0.1:8080/api/v1/public/clips/<event_id>.mp4
# Public nginx port
NEXUS_DS_PORT=8080

# Postgres
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus_deepstream

# MinIO — host ports 9200/9201 so they do not clash with Campus (9100/9101)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201

NEXUS_DS_MINIO_ENDPOINT_URL=http://minio:9000
NEXUS_DS_MINIO_ACCESS_KEY=minioadmin
NEXUS_DS_MINIO_SECRET_KEY=minioadmin
NEXUS_DS_MINIO_BUCKET=incidents
# Optional. Same Ubuntu as Campus: leave empty (default host-gateway / 172.17.0.1).
# Two servers: http://<this-machine-lan-ip>:8080
# NEXUS_DS_PUBLIC_URL=

# Internal video control plane (:8081). Same value on API and video containers.
NEXUS_DS_VIDEO_TOKEN=nexus-video-internal

# Local RTSP test (docker-compose.rtsp-test.yml)
# RTSP_TEST_SIZE=1280x720
# RTSP_TEST_FPS=25

